{
  "expo": {
    "name": "Mama & Baby Bites",
    "slug": "mamababybites",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mamababybites",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.mamababybites.app",
      "supportsTablet": false,
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["0A2A.1", "3B52.1", "C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["85F4.1", "E174.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          }
        ]
      }
    },
    "android": {
      "package": "com.mamababybites.app",
      "adaptiveIcon": {
        "backgroundColor": "#F7EEDC",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      ["expo-router", { "origin": "https://mamababybites.expo.app/" }],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7EEDC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 340
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#487549"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "TodayMeals",
              "displayName": "Today's meals",
              "description": "Your baby's breakfast, lunch and dinner from the meal plan.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium"]
              }
            }
          ]
        }
      ],
      "expo-video",
      "expo-iap"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "593d34b6-a054-48bd-b939-a67a2b5ae77a"
      }
    }
  }
}
